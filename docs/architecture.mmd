flowchart TD
    %% ===============================================================
    %% AgentCart — Visual Architecture Diagram for 5-Minute Pitch
    %% ===============================================================

    subgraph CLIENT["Client Interface Layer"]
        USER(["User (Voice / Natural Language Goal)"])
        UI["React Frontend UI<br/>(Vite + TailwindCSS + SSE Client)"]
    end

    subgraph BACKEND["FastAPI Backend Server (:8000)"]
        API["FastAPI Routing Gateway<br/>(/api/agent/run, /api/agent/approve-hitl)"]

        subgraph AI_LAYER["AI / Reasoning Layer (Zero Financial Authority)"]
            GEMINI["Gemini Intent Parser<br/>(Structured Extraction)"]
            AGENT["Buyer Agent Engine<br/>(Autonomous Reasoning Loop)"]
            MCP["MCP Tools Interface<br/>(search_catalog, get_product_details)"]
        end

        subgraph CATALOG_LAYER["Merchant Truth Layer"]
            CATALOG[("Merchant Catalog & SQLite DB<br/>Authoritative Prices & Live Stock")]
            PROPOSAL["Grounded Order Proposal<br/>(Itemized Cart + DB Prices)"]
        end

        subgraph SECURITY_LAYER["Deterministic Security Boundary"]
            POLICY{"Deterministic Policy Engine<br/>(Server-Side Guardrails)"}
            AUTO_PATH["Tier 1: Autonomous Pre-Auth<br/>(Total <= ₹3,000)"]
            HITL_GATE["Tier 2: HMAC-SHA256 Sign-off Gate<br/>(₹3,001 <= Total <= ₹10,000)"]
            BLOCK_PATH["Tier 3: Hard Policy Rejection<br/>(Total > ₹10,000 / Stock Breach)"]
        end

        subgraph PAYMENT_LAYER["Payment Rails Layer"]
            RAZORPAY["Razorpay Payment Service<br/>(Orders API + Signature Verification)"]
            SETTLEMENT["Payment Capture & Settlement<br/>(₹ Rupee Transfer)"]
        end

        subgraph AUDIT_LAYER["Audit / Governance Layer"]
            LEDGER[("SHA-256 Chained Cryptographic Ledger<br/>Tamper-Evident Immutable DB")]
        end
    end

    %% Workflow Connections
    USER -->|"1. Speaks or Types Goal"| UI
    UI -->|"2. POST /api/agent/run"| API
    API -->|"3. Stream Execution"| AGENT
    AGENT -->|"4. Parse Intent"| GEMINI
    GEMINI -->|"5. Structured Intent"| AGENT
    AGENT -->|"6. Tool Queries"| MCP
    MCP <-->|"7. Live Stock & Price Lookup"| CATALOG
    AGENT -->|"8. Form Proposal"| PROPOSAL
    PROPOSAL -->|"9. Recalculate & Verify"| POLICY

    %% Policy Decisions
    POLICY -->|"<= ₹3,000"| AUTO_PATH
    POLICY -->|"₹3,001 – ₹10,000"| HITL_GATE
    POLICY -->|"> ₹10,000"| BLOCK_PATH

    %% Execution Paths
    AUTO_PATH -->|"Auto-Authorize"| RAZORPAY
    HITL_GATE -->|"Human Approves (HMAC Token)"| RAZORPAY
    HITL_GATE -->|"Human Rejects"| LEDGER
    BLOCK_PATH -->|"Hard Block Event"| LEDGER

    %% Payment & Audit
    RAZORPAY -->|"Payment Verified"| SETTLEMENT
    SETTLEMENT -->|"Record Chained Hash"| LEDGER
    LEDGER -.->|"Cryptographic Audit Stream"| UI

    %% Styling & Classes
    classDef clientStyle fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0369a1;
    classDef aiStyle fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#92400e;
    classDef securityStyle fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#991b1b;
    classDef paymentStyle fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#166534;
    classDef auditStyle fill:#f3e8ff,stroke:#9333ea,stroke-width:2px,color:#6b21a8;

    class USER,UI clientStyle;
    class GEMINI,AGENT,MCP,PROPOSAL aiStyle;
    class POLICY,AUTO_PATH,HITL_GATE,BLOCK_PATH securityStyle;
    class RAZORPAY,SETTLEMENT paymentStyle;
    class LEDGER auditStyle;
